{
  "_about": "Fixed inputs with exact expected outputs. 'kit.py calc' checks the formulas offline; 'kit.py calc --live --yes' asks the bot and compares its KEY NUMBERS. Amounts in full units (USD, shares); percentages and probabilities as percent.",
  "cases": [
    {"id": "C1", "ask": "market cap, enterprise value and EV/revenue",
     "inputs": {"price": 20, "diluted_shares": 100000000, "debt": 300000000, "cash": 150000000, "revenue": 430000000},
     "expected": {"market_cap": 2000000000, "enterprise_value": 2150000000, "EV/Revenue": 5.0}},
    {"id": "C2", "ask": "market cap and enterprise value, counting preferred stock and minority interest",
     "inputs": {"price": 12.5, "diluted_shares": 80000000, "debt": 0, "cash": 200000000,
                "preferred": 50000000, "minority_interest": 25000000},
     "expected": {"market_cap": 1000000000, "enterprise_value": 875000000}},
    {"id": "C3", "ask": "P/E and EV/EBITDA",
     "inputs": {"price": 45, "diluted_shares": 40000000, "debt": 250000000, "cash": 50000000,
                "net_income": 90000000, "ebitda": 200000000},
     "expected": {"market_cap": 1800000000, "enterprise_value": 2000000000, "P/E": 20.0, "EV/EBITDA": 10.0}},
    {"id": "C4", "ask": "year-on-year revenue growth and the operating margin",
     "inputs": {"revenue": 150000000, "revenue_prior": 100000000, "operating_income": -30000000},
     "expected": {"revenue_growth_pct": 50.0, "operating_margin_pct": -20.0}},
    {"id": "C5", "ask": "the market cap at the low, mid and high end of a $17 to $19 IPO price range",
     "inputs": {"offer_price_low": 17, "offer_price_high": 19, "diluted_shares": 250000000},
     "expected": {"market_cap_low": 4250000000, "market_cap_mid": 4500000000, "market_cap_high": 4750000000}},
    {"id": "C6", "ask": "the probability-weighted value, the expected return and the rating (conviction Medium)",
     "inputs": {"price": 20},
     "scenarios": {"reference_price": 20, "bull": {"value": 30, "prob": 25}, "base": {"value": 23, "prob": 50},
                   "bear": {"value": 12, "prob": 25}},
     "conviction": "Medium",
     "expected": {"pwv": 22.0, "expected_return_pct": 10.0, "rating": "Equal-weight"}},
    {"id": "C7", "ask": "the probability-weighted value, the expected return, the rating (conviction Medium) and the buy-below price",
     "inputs": {"price": 50},
     "scenarios": {"reference_price": 50, "bull": {"value": 80, "prob": 30}, "base": {"value": 62, "prob": 50},
                   "bear": {"value": 35, "prob": 20}},
     "conviction": "Medium",
     "expected": {"pwv": 62.0, "expected_return_pct": 24.0, "rating": "Overweight", "buy_below": 53.91304347826087}},
    {"id": "C8", "ask": "the probability-weighted value, the expected return and the rating (conviction High)",
     "inputs": {"price": 100},
     "scenarios": {"reference_price": 100, "bull": {"value": 110, "prob": 20}, "base": {"value": 90, "prob": 50},
                   "bear": {"value": 60, "prob": 30}},
     "conviction": "High",
     "expected": {"pwv": 85.0, "expected_return_pct": -15.0, "rating": "Underweight"}},
    {"id": "C9", "ask": "the market cap in US dollars, converting at EUR/USD 1.10",
     "inputs": {"price_eur": 50, "diluted_shares": 10000000, "eurusd": 1.10},
     "expected": {"market_cap_usd": 550000000}}
  ]
}
